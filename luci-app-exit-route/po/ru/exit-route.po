msgid "Action"
msgstr "Действие"

msgid "Active"
msgstr "Активен"

msgid "Active route"
msgstr "Активный маршрут"

msgid "Add device"
msgstr "Добавить устройство"

msgid "Auto"
msgstr "Авто"

msgid "Automatically selected according to exit priority."
msgstr "Автоматический выбор по приоритету выходов."

msgid "Command failed"
msgstr "Ошибка выполнения команды"

msgid "Deployment"
msgstr "Из деплоя"

msgid "Device"
msgstr "Устройство"

msgid "Device / IP"
msgstr "Устройство / IP"

msgid "Device routing"
msgstr "Маршрутизация устройств"

msgid "Direct routing through the main routing table."
msgstr "Прямая маршрутизация через основную таблицу."

msgid "Enter a valid unicast IPv4 address."
msgstr "Введите корректный одноадресный IPv4-адрес."

msgid "Exit Route"
msgstr "Маршрутизация через выходы"

msgid "Exits use Babel routes; WAN uses the main default route, not a ping."
msgstr "Доступность выходов определяется маршрутами Babel. Для WAN проверяется маршрут по умолчанию в таблице main, а не доступность интернета."

msgid "Exit status"
msgstr "Состояние выходов"

msgid "Global route"
msgstr "Общий маршрут"

msgid "IPv4 address"
msgstr "IPv4-адрес"

msgid "Interface"
msgstr "Интерфейс"

msgid "Manual override enabled."
msgstr "Ручной выбор активен."

msgid "No devices found. Add an IPv4 address below."
msgstr "Устройства не найдены. Добавьте IPv4-адрес ниже."

msgid "No route"
msgstr "Маршрута нет"

msgid "Override routing for IPv4 devices. Changes apply immediately."
msgstr "Настройка отдельного маршрута для IPv4-устройств. Изменения применяются сразу."

msgid "Reachable"
msgstr "Доступен"

msgid "Restore"
msgstr "Восстановить"

msgid "Restore deployment rule"
msgstr "Вернуть правило из деплоя"

msgid "Route"
msgstr "Маршрут"

msgid "Route available"
msgstr "Маршрут доступен"

msgid "Routing table"
msgstr "Таблица маршрутизации"

msgid "Select the default exit for traffic without device-specific rules."
msgstr "Выберите выход по умолчанию для трафика без индивидуальных правил."

msgid "Select exit..."
msgstr "Выбрать выход..."

msgid "Selected mode"
msgstr "Выбранный режим"

msgid "Service running"
msgstr "Служба запущена"

msgid "Service stopped"
msgstr "Служба остановлена"

msgid "Split via %s"
msgstr "Раздельная маршрутизация через %s"

msgid "The selected exit is unreachable; the global exit route is disabled."
msgstr "Выбранный выход недоступен; общий exit-маршрут отключён."

msgid "Tunnel"
msgstr "Туннель"

msgid "Unknown"
msgstr "Неизвестно"

msgid "Unreachable"
msgstr "Недоступен"

msgid "Use global route"
msgstr "Использовать общий маршрут"

msgid "Via interface"
msgstr "Через интерфейс"

msgid "AUTO priorities"
msgstr "Приоритеты AUTO"

msgid "Drag exits within or between lists to set AUTO priorities."
msgstr "Перетаскивайте выходы внутри списков и между ними для настройки AUTO."

msgid "Keep at least one exit in AUTO."
msgstr "В AUTO должен оставаться хотя бы один выход."

msgid "Drag to reorder. Use arrow keys or Enter as an alternative."
msgstr "Перетащите для изменения порядка. Также доступны стрелки и Enter."

msgid "Move exit %s"
msgstr "Переместить выход %s"

msgid "Restore deployment priorities"
msgstr "Восстановить приоритеты генератора"

msgid "Cancel"
msgstr "Отменить"

msgid "Save and apply"
msgstr "Сохранить и применить"

msgid "In AUTO (top priority first)"
msgstr "Участвуют в AUTO (по убыванию приоритета)"

msgid "Not in AUTO (manual selection remains available)"
msgstr "Не участвуют в AUTO (доступны для ручного выбора)"

msgid "Priorities are saved."
msgstr "Приоритеты сохранены."

msgid "Unsaved AUTO changes."
msgstr "Несохранённые изменения AUTO."

